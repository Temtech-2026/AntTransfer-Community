# 传输编排与业务主流程
# /server/at-transfer/        @anttransfer/core-maintainers
# 数据库迁移：只增不改，回滚成本最高
# /sql/                       @anttransfer/db-maintainers
# 镜像构建与非 root / 健康检查口径
# /Dockerfile                 @anttransfer/ops-maintainers
# 编排：卷、探针、依赖顺序、端口绑定
# /docker-compose.yml         @anttransfer/ops-maintainers
# /docker-compose.dev.yml     @anttransfer/ops-maintainers
# CI 门禁与安全扫描
# /.github/workflows/         @anttransfer/ops-maintainers
