<!--
  =====================================================================
  at-collaboration — 协作共享业务模块

  职责：多人协作空间 CollaborationSpace（成员邀请 / 共享传输任务 / 访问控制）、
  分享链接与协作者管理，支撑“社区 + 传输”的协作玩法。

  依赖规则：仅依赖 at-common，禁止依赖其他 at-* 业务模块。
  =====================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.anttransfer</groupId>
        <artifactId>anttransfer-ce</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>at-collaboration</artifactId>
    <name>at-collaboration</name>
    <description>AntTransfer 协作共享：多人协作空间 / 成员 / 分享</description>

    <dependencies>
        <!-- 共享内核：Result / ErrorCode / BaseEntity / BusinessException -->
        <dependency>
            <groupId>com.anttransfer</groupId>
            <artifactId>at-common</artifactId>
        </dependency>
        <!-- Lombok：编译期注解（optional 不传递） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
