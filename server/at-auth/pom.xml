<!--
  =====================================================================
  at-auth — 认证鉴权业务模块

  职责：登录态（Token / Session）、用户身份上下文 LoginUser、
  登录校验注解 RequireLogin 等。后续可在此扩展 JWT 签发校验（jjwt 版本已在父工程锁定）。

  依赖规则：仅依赖 at-common，禁止依赖其他 at-* 业务模块。
  =====================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.anttransfer</groupId>
        <artifactId>anttransfer-ce</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>at-auth</artifactId>
    <name>at-auth</name>
    <description>AntTransfer 认证鉴权：登录态 / 用户身份 / 登录校验注解</description>

    <dependencies>
        <!-- 共享内核：Result / ErrorCode / BusinessException -->
        <dependency>
            <groupId>com.anttransfer</groupId>
            <artifactId>at-common</artifactId>
        </dependency>
        <!-- Lombok：编译期注解（optional 不传递） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
