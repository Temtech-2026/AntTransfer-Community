<!--
  =====================================================================
  at-bootstrap — 聚合启动模块（唯一可运行模块）

  职责：
    1. 聚合依赖全部 at-* 模块，形成“模块化单体”的最终可执行产物；
    2. 提供启动类 AntTransferApplication 与 application*.yml 配置；
    3. 独占 spring-boot-maven-plugin（repackage 可执行 fat jar）。

  说明：本模块不含业务逻辑，仅做依赖聚合与装配，因此业务代码几乎为 0。
  =====================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.anttransfer</groupId>
        <artifactId>anttransfer-ce</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>at-bootstrap</artifactId>
    <name>at-bootstrap</name>
    <description>AntTransfer 聚合启动模块（唯一可运行模块）</description>

    <dependencies>
        <!-- ============ 内部模块（聚合全部 at-* 模块） ============ -->
        <!-- 共享内核 -->
        <dependency>
            <groupId>com.anttransfer</groupId>
            <artifactId>at-common</artifactId>
        </dependency>
        <!-- 统一接入层：全局异常 / 链路追踪 / CORS -->
        <dependency>
            <groupId>com.anttransfer</groupId>
            <artifactId>at-gateway</artifactId>
        </dependency>
        <!-- 业务域：认证鉴权 -->
        <dependency>
            <groupId>com.anttransfer</groupId>
            <artifactId>at-auth</artifactId>
        </dependency>
        <!-- 业务域：权限控制 -->
        <dependency>
            <groupId>com.anttransfer</groupId>
            <artifactId>at-permission</artifactId>
        </dependency>
        <!-- 业务域：传输任务 -->
        <dependency>
            <groupId>com.anttransfer</groupId>
            <artifactId>at-transfer</artifactId>
        </dependency>
        <!-- 业务域：文件存储 -->
        <dependency>
            <groupId>com.anttransfer</groupId>
            <artifactId>at-file</artifactId>
        </dependency>
        <!-- 业务域：协作共享 -->
        <dependency>
            <groupId>com.anttransfer</groupId>
            <artifactId>at-collaboration</artifactId>
        </dependency>

        <!-- ============ 基础设施 starter（版本由 Spring Boot BOM / 父工程锁定） ============ -->
        <!-- Web MVC + 内嵌 Tomcat -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Redis（连接与缓存，后续可配合 Spring Session 做分布式会话） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- MyBatis-Plus（Boot3 专用 starter） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- MyBatis-Plus 分页插件依赖（v3.5.9+ 独立模块） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <!-- MySQL 驱动（运行期） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- PostgreSQL 驱动（运行期；pg profile 使用，SQL 需按 V1 头注改写为 PG 方言） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Flyway：数据库版本化迁移（版本由 Boot BOM 锁定；默认启动自动迁移，见 application.yml）。
             flyway-core 通用引擎 + flyway-mysql / flyway-database-postgresql 两库方言支持 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- SpringDoc OpenAPI3 + Swagger UI（接口文档，dev 开启 / prod 关闭） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <!-- Actuator：只用 health 与 info 两个探针端点（暴露白名单见 application.yml 的
             management 段，严禁改为 '*'）。info 回显 META-INF/build-info.properties——
             版本号、提交号、构建时间，使「线上跑的是哪个提交」可一条命令查证；
             health 供负载均衡 / 容器编排在无凭证上下文探测。两者在 at-auth 的
             SecurityConfig.BUILT_IN_PERMIT_ALL 中匿名放行，且不返回任何组件明细。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ============ 测试 ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers：集成测试自动拉起 MySQL + Redis（版本由 Boot BOM 锁定） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 仅 at-bootstrap 使用 spring-boot-maven-plugin：将全部模块打为可执行 fat jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.anttransfer.AntTransferApplication</mainClass>
                    <!-- 排除 Lombok，避免打入最终产物 -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                    <!-- 生成 META-INF/build-info.properties：
                           · build.version / build.time / build.artifact —— 由插件自动采集；
                           · build.commitId / build.branch —— 来自 additionalProperties，
                             取值是父 pom <properties> 里的 git.commit / git.branch（默认 unknown），
                             Docker 构建时由 Dockerfile 以 -Dgit.commit=... 传入。
                         该文件由 GET /api/actuator/info 回显，是「线上跑的是哪个提交」的权威来源；
                         build-info 绑定在 generate-resources 阶段，`mvn package` 自动执行，
                         需单独触发时用：mvn -pl server/at-bootstrap spring-boot:build-info@build-info -->
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                        <configuration>
                            <additionalProperties>
                                <commitId>${git.commit}</commitId>
                                <branch>${git.branch}</branch>
                            </additionalProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Flyway 迁移脚本：构建期将仓库根 sql/（唯一事实源）打包进本模块 classpath
                 db/migration，使 application.yml 中 locations=classpath:db/migration 与实际脚本
                 所在始终一致——dev（spring-boot:run / IDE）与 prod（fat jar / 容器）共用同一批脚本，
                 新增 V*.sql 后无需任何手工复制，重新构建即生效。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-flyway-migrations</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/db/migration</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../../sql</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>V*.sql</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
