<!--
  =====================================================================
  at-file — 文件存储业务模块

  职责：文件元数据 FileObject 与多后端存储抽象（本地磁盘 / 对象存储 OSS-COS-S3），
  上传下载、分片、秒传（sha256）、内容类型嗅探、外发分享（sys_share_link）等。

  依赖规则：仅依赖 at-common，禁止依赖其他 at-* 业务模块。
  =====================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.anttransfer</groupId>
        <artifactId>anttransfer-ce</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>at-file</artifactId>
    <name>at-file</name>
    <description>AntTransfer 文件存储：元数据 / 本地与对象存储多后端</description>

    <dependencies>
        <!-- 共享内核：Result / ErrorCode / BaseEntity / BusinessException / RedisKeyConstants -->
        <dependency>
            <groupId>com.anttransfer</groupId>
            <artifactId>at-common</artifactId>
        </dependency>
        <!-- Spring 基础（IoC/事件 ApplicationEventPublisher）：供 Service 使用 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- Spring Web MVC：分享控制器 / 免登录访客接口 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Jakarta Bean Validation：创建分享 / 访客校验入参校验（@NotBlank / @Size / @Valid） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Spring Security Core：SecurityContext 读取 + BCryptPasswordEncoder（提取码加盐散列） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
        <!-- Redis：下载次数前置配额闸 / 提取码锁定计数 / 一次性票据（GETDEL） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- MyBatis-Plus：@Mapper 自动装配 + BaseMapper + Lambda 条件构造器（运行时由 at-bootstrap 聚合） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- Lombok：编译期注解（optional 不传递） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ============ 测试 ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
