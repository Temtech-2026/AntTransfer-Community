<!--
  =====================================================================
  at-gateway — 统一接入层 / 横切关注点模块

  职责：
    1. 全局异常处理器 GlobalExceptionHandler：统一转换为 Result 返回；
    2. TraceIdFilter：请求入口生成 / 透传 traceId（贯穿日志与响应头）；
    3. 全局 CORS、编码等 WebMvc 横切配置。

  依赖规则：只允许依赖 at-common（本模块不持有任何业务逻辑；
  业务模块间的调用在 at-bootstrap 聚合运行时完成）。
  =====================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.anttransfer</groupId>
        <artifactId>anttransfer-ce</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>at-gateway</artifactId>
    <name>at-gateway</name>
    <description>AntTransfer 统一接入层：全局异常 / 链路追踪 / CORS</description>

    <dependencies>
        <!-- 共享内核：Result / ErrorCode / TraceUtils 等 -->
        <dependency>
            <groupId>com.anttransfer</groupId>
            <artifactId>at-common</artifactId>
        </dependency>
        <!-- Spring MVC Web：@RestControllerAdvice / Filter / WebMvcConfigurer 的编译与运行基础 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Jakarta Validation：@Valid / @Validated 生效前提（Boot 2.3+ 起不再随 web starter 传递），
             同时提供全局异常处理器所需的 jakarta.validation.ConstraintViolationException -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- AOP：@RateLimit 注解切面（横切限流，at-gateway 统一承载） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!-- Redis：@RateLimit 固定窗口计数实现 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Spring Security Core：全局异常处理区分 AccessDeniedException（仅 core，不引入过滤链） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>

        <!-- ============ 测试 ============ -->
        <!-- 全局异常与错误码映射单测：JUnit 5 / AssertJ / MockMvc（版本由 Spring Boot BOM 锁定）。
             本模块此前无测试代码，故测试依赖在此显式声明，不依赖其它模块传递。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
