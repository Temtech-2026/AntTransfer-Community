# =====================================================================
# AntTransfer CE .gitignore
# 覆盖范围：Java / Maven、Node、IDE、操作系统、本地配置与密钥、运行数据
# =====================================================================

# ============ Java / Maven 构建产物 ============
target/
*.class
out/
dependency-reduced-pom.xml
buildNumber.properties
release.properties
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
.mvn/timing.properties

# 打包产物（若确有需要随仓库分发的 jar，请在下方用 ! 显式取消忽略）
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven Wrapper 自带的 wrapper jar（保留不忽略）
!.mvn/wrapper/maven-wrapper.jar

# JVM 崩溃日志
hs_err_pid*

# 日志
*.log
logs/

# ============ Node / 前端（仓库内若引入 Node 工程时生效） ============
node_modules/
# 前端构建产物与 umi 运行时缓存（Ant Design Pro / Umi）
**/dist/
**/.umi/
**/.umi-production/

.pnpm-store/
.yarn/
*.node
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============ IDE ============
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# Eclipse / STS
.classpath
.project
.settings/
.factorypath
.apt_generated
.sts4-cache
.springBeans

# VS Code / Cursor 等
.vscode/
*.code-workspace

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# ============ 操作系统 / 编辑器残留 ============
# macOS
.DS_Store
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory

# 通用编辑器临时文件
*~
*.swp
*.swo
*.*~

# ============ 本地配置（禁止提交，防止泄露） ============
# Spring Boot 本地 profile（application-local.yml 等，属于“本机专属配置”）
application-local.yml
application-local.yaml
application-local.properties
application-*-local.yml
application-*-local.yaml
application-*-local.properties

# 环境变量文件（.env 类一律忽略，仅保留 .env.example 模板）
.env
.env.*
*.env.local
.envrc
!.env.example

# ============ 密钥与证书（禁止提交） ============
# 私钥 / 密钥对
*.pem
*.key
*.ppk
id_rsa
id_dsa
*.p8
*.pkcs8

# 密钥库（含私钥）
*.p12
*.pfx
*.jks
*.jceks
*.keystore

# 通用 secret 文件
.secrets
secrets.yml
*.secret

# ============ 运行数据目录 ============
# 应用运行时产生的数据：本地文件存储、上传临时目录、缓存、索引等，一律不入库
data/
uploads/
temp/
.cache/

# 本地验证/评估用临时载体（Flyway 校验等一次性产物，禁止入库）
.verify_tmp/
.verify/

# ============ 本机工具产物（禁止提交） ============
# playwright-cli 会话缓存（登录态、页面 dump，数量上百，属工具私有状态）
.playwright-cli/
# playwright-cli 落在仓库根的快照残留（非项目配置）
login.yaml
document.title
