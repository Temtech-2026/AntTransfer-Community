# =====================================================================
# 复制本文件为 .env 后按需修改；.env 已被 .gitignore 忽略，禁止提交真实密钥。
# 供 docker-compose.yml / docker-compose.dev.yml 读取。
#
# ⚠️ 两份编排的校验强度不同：
#   · docker-compose.dev.yml（仅本地开发依赖 MySQL + Redis）：全部带默认值，零配置可启动；
#   · docker-compose.yml（完整环境，生产语义）：对 DB_PASSWORD 与 AUTH_ACCESS_TOKEN_SECRET
#     使用 ${VAR:?} 强制校验——未设置或为空时 `docker compose up` 直接报错退出，
#     绝不会回落到 123456 之类的弱口令或 application.yml 里的开发默认密钥。
# =====================================================================

# ---------------- MySQL ----------------
# ⚠️ MYSQL_PORT 是容器 MySQL 在宿主机上的端口，刻意用 3307 错开本机自装 MySQL 的 3306：
#    容器没起来时后端连 3307 会直接失败，不会静默连上本机 3306 的库造成「迁移成功」的假象。
#    改动此端口后，后端 DB_URL 需同步修改（application.yml 默认值即为 3307）。
#    该端口仅绑定宿主 127.0.0.1（见 docker-compose.yml），公网与内网其它机器均不可直连。
DB_USERNAME=root

# 必填（docker-compose.yml）。留空或删除该行都会让完整环境拒绝启动。
DB_PASSWORD=
MYSQL_PORT=3307

# ---------------- Redis ----------------
# 同样仅绑定宿主 127.0.0.1；Redis 未启用密码，其安全边界即「不对外暴露」。
REDIS_PORT=6379

# ---------------- 后端 ----------------
# 后端对外端口同样仅绑定 127.0.0.1，由前置反向代理（80/443 上的 Nginx / 网关）转发进入。
SERVER_PORT=8080

# =====================================================================
# 以下为生产必需项（docker-compose.yml 会消费）
# =====================================================================

# ① JWT 签名密钥（HS256，须 ≥ 32 字节）。必填。
#    这里刻意留空以触发强制校验：application.yml 内置的 dev 默认值是公开已知的，
#    一旦回落到它，任何人都能自行签发合法 token。
#    生成示例：
#      Linux / macOS : openssl rand -base64 48
#      PowerShell    : [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
AUTH_ACCESS_TOKEN_SECRET=

# ② CORS 白名单，逗号分隔，支持通配（如 https://*.your-domain.com）。
#    前后端同源部署（同一域名下由反向代理转发 /api）时用不到，保持默认即可；
#    跨域部署必须改为真实前端来源。严禁使用 *——携带凭证场景下它等于对全网开放。
ANTTRANSFER_CORS_ALLOWED_ORIGINS=http://localhost:8000
